// ============================================================================
// Event Ticket Booking Platform — Prisma schema (PostgreSQL)
// ============================================================================
// This schema is intentionally the ONLY part I'm giving you fully solved.
// The logic that uses it correctly (atomic holds, idempotent webhooks,
// transactional confirm) is yours to design and implement.
//
// Read the comments — they flag WHY each field/constraint exists, not just
// what it is. Some of these fields only make sense once you hit the problem
// they solve.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Users — kept minimal on purpose. Plug in your own auth (Clerk, NextAuth,
// whatever) and just make sure a row here exists per authenticated user.
// ----------------------------------------------------------------------------
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  holds        Hold[]
  bookings     Booking[]
  notifications Notification[]
}

// ----------------------------------------------------------------------------
// Event — note `seatsAvailable` is a live counter, not derived on read.
// This is a deliberate design choice: it's what makes atomic
// increment/decrement possible in a single statement (see the "why" below).
// You could instead compute available seats as
// (totalSeats - count(confirmed bookings)) on every read, but that pushes
// the concurrency problem onto a COUNT query under load, which has its own
// race conditions. Think about the tradeoff — you may end up wanting both
// (a live counter AND a way to reconcile/audit it against actual bookings).
// ----------------------------------------------------------------------------
model Event {
  id             String   @id @default(cuid())
  title          String
  description    String
  venue          String
  startsAt       DateTime
  totalSeats     Int
  seatsAvailable Int      // decremented atomically on hold, restored on release
  priceCents     Int
  organizerId    String
  createdAt      DateTime @default(now())

  holds    Hold[]
  bookings Booking[]

  @@index([startsAt])
}

// ----------------------------------------------------------------------------
// Hold — a temporary reservation of N seats while "payment" is simulated.
// `expiresAt` + a background job (NOT setTimeout) is what reclaims seats
// from abandoned holds. Status transitions you'll need to handle:
//   PENDING -> CONFIRMED   (payment succeeded before expiry)
//   PENDING -> EXPIRED     (background job caught it after expiresAt)
//   PENDING -> CANCELLED   (user backed out, or payment failed)
//
// Why a separate model instead of just a status field on Booking? Because
// a Hold that never gets paid should NOT become a permanent booking record —
// keeping them separate makes the "did this ever become real" question
// unambiguous, and makes it obvious in the schema that Hold is the
// temporary/unsafe state and Booking is the durable/confirmed one.
// ----------------------------------------------------------------------------
model Hold {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  quantity  Int
  status    HoldStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  event   Event    @relation(fields: [eventId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  booking Booking?

  @@index([status, expiresAt]) // your expiry job will query on exactly this
}

enum HoldStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

// ----------------------------------------------------------------------------
// Booking — the durable, confirmed record. One-to-one with the Hold that
// produced it. `holdId` is unique — think about why that uniqueness
// constraint matters for the idempotency problem specifically.
// ----------------------------------------------------------------------------
model Booking {
  id        String   @id @default(cuid())
  holdId    String   @unique
  eventId   String
  userId    String
  quantity  Int
  createdAt DateTime @default(now())

  hold  Hold  @relation(fields: [holdId], references: [id])
  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
}

// ----------------------------------------------------------------------------
// WebhookEvent — this table IS your idempotency mechanism for incoming
// payment webhooks. The unique constraint on `providerEventId` is what lets
// you answer "have I already processed this exact event?" atomically,
// instead of a read-then-write check that races under concurrent duplicate
// deliveries. Think about *when* in your handler you insert this row.
// ----------------------------------------------------------------------------
model WebhookEvent {
  id               String   @id @default(cuid())
  providerEventId  String   @unique
  type             String
  payload          Json
  processedAt      DateTime @default(now())
}

// ----------------------------------------------------------------------------
// Notification — deliberately just a durable record. How it gets pushed to
// a connected client in real time (WebSocket/SSE) is your job to wire up;
// this table is what makes notifications survive even if the user isn't
// connected at the moment they're created (they can fetch missed ones).
// ----------------------------------------------------------------------------
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // e.g. "HOLD_EXPIRING", "BOOKING_CONFIRMED", "EVENT_SOLD_OUT"
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
}

import { PrismaClient } from "@prisma/client";

const prisma = new PrismaClient();

async function main() {
  console.log("🌱 Starting database seed...");

  // --------------------------------------------------------------------------
  // 1. Create test users
  // --------------------------------------------------------------------------

  const organizer = await prisma.user.upsert({
    where: {
      email: "organizer@test.com",
    },
    update: {},
    create: {
      email: "organizer@test.com",
      name: "Test Organizer",
    },
  });

  const user1 = await prisma.user.upsert({
    where: {
      email: "user1@test.com",
    },
    update: {},
    create: {
      email: "user1@test.com",
      name: "Test User One",
    },
  });

  const user2 = await prisma.user.upsert({
    where: {
      email: "user2@test.com",
    },
    update: {},
    create: {
      email: "user2@test.com",
      name: "Test User Two",
    },
  });

  console.log("✅ Test users created");

  // --------------------------------------------------------------------------
  // 2. Create the concurrency test event
  // --------------------------------------------------------------------------

  const concurrencyEvent = await prisma.event.upsert({
    where: {
      id: "concurrency-test-event",
    },
    update: {
      title: "Concurrency Test Event",
      description: "Used for testing concurrent ticket reservations.",
      venue: "Test Arena",
      startsAt: new Date("2026-12-01T18:00:00Z"),
      totalSeats: 500,
      seatsAvailable: 500,
      priceCents: 1000,
      organizerId: organizer.id,
    },
    create: {
      id: "concurrency-test-event",
      title: "Concurrency Test Event",
      description: "Used for testing concurrent ticket reservations.",
      venue: "Test Arena",
      startsAt: new Date("2026-12-01T18:00:00Z"),
      totalSeats: 500,
      seatsAvailable: 500,
      priceCents: 1000,
      organizerId: organizer.id,
    },
  });

  // --------------------------------------------------------------------------
  // 3. Create normal test events
  // --------------------------------------------------------------------------

  const techEvent = await prisma.event.upsert({
    where: {
      id: "tech-conference-2026",
    },
    update: {},
    create: {
      id: "tech-conference-2026",
      title: "Lagos Tech Conference 2026",
      description:
        "A technology conference bringing developers, founders and technology enthusiasts together.",
      venue: "Landmark Event Centre",
      startsAt: new Date("2026-10-10T10:00:00Z"),
      totalSeats: 2000,
      seatsAvailable: 2000,
      priceCents: 250000,
      organizerId: organizer.id,
    },
  });

  const musicEvent = await prisma.event.upsert({
    where: {
      id: "music-festival-2026",
    },
    update: {},
    create: {
      id: "music-festival-2026",
      title: "Lagos Music Festival 2026",
      description:
        "A live music festival featuring artists from Nigeria and around the world.",
      venue: "Tafawa Balewa Square",
      startsAt: new Date("2026-11-20T16:00:00Z"),
      totalSeats: 5000,
      seatsAvailable: 5000,
      priceCents: 500000,
      organizerId: organizer.id,
    },
  });

  console.log("✅ Events created");

  // --------------------------------------------------------------------------
  // 4. Print useful IDs
  // --------------------------------------------------------------------------

  console.log("\n📋 Seed data:");
  console.log("----------------------------------------");

  console.log("Organizer:");
  console.log(`  ID:    ${organizer.id}`);
  console.log(`  Email: ${organizer.email}`);

  console.log("\nUsers:");
  console.log(`  User 1: ${user1.id}`);
  console.log(`  User 2: ${user2.id}`);

  console.log("\nEvents:");
  console.log(`  Concurrency test: ${concurrencyEvent.id}`);
  console.log(`  Tech conference:  ${techEvent.id}`);
  console.log(`  Music festival:   ${musicEvent.id}`);

  console.log("----------------------------------------");
  console.log("🌱 Database seed completed successfully!");
}

main()
  .catch((error) => {
    console.error("❌ Seed failed:");
    console.error(error);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });